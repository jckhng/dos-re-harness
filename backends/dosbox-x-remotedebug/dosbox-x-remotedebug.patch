+static void DosReHarness_LogOplWrite(uint32_t reg, uint8_t val) {
+    static FILE *log = nullptr;
+    static bool initialized = false;
+    static bool include_loop_tick = false;
+    static PhysPt loop_tick_address = 0;
+
+    if (!initialized) {
+        initialized = true;
+        const char *path = getenv("DOS_RE_HARNESS_OPL_LOG");
+        const char *loop_tick = getenv("DOS_RE_HARNESS_OPL_TICK_LINEAR");
+        if (loop_tick && *loop_tick) {
+            char *end = nullptr;
+            const unsigned long parsed = strtoul(loop_tick, &end, 0);
+            if (end != loop_tick && *end == '\0') {
+                include_loop_tick = true;
+                loop_tick_address = static_cast<PhysPt>(parsed);
+            }
+        }
+        if (path && *path) {
+            log = fopen(path, "wb");
+            if (log) {
+                if (include_loop_tick) {
+                    fputs("tick_ms,loop_tick,reg_hex,value_hex\n", log);
+                } else {
+                    fputs("tick_ms,reg_hex,value_hex\n", log);
+                }
+                fflush(log);
+            }
+        }
+    }
+
+    if (log) {
+        if (include_loop_tick) {
+            fprintf(log, "%.6f,%u,0x%03x,0x%02x\n", static_cast<double>(PIC_Ticks), static_cast<unsigned>(mem_readw(loop_tick_address)), static_cast<unsigned>(reg), static_cast<unsigned>(val));
+        } else {
+            fprintf(log, "%.6f,0x%03x,0x%02x\n", static_cast<double>(PIC_Ticks), static_cast<unsigned>(reg), static_cast<unsigned>(val));
