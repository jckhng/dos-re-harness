+bool QMPServer::process_guest_state_input(uint32_t linear_pc,
+                                          uint32_t instruction_offset,
+                                          uint32_t ds_base) {
+    struct StateInputEvent {
+        uint64_t value;
+        bool pressed;
+        std::vector<KBD_KEYS> keys;
+        std::vector<std::string> qcodes;
+    };
+
+    static bool initialized = false;
+    static bool enabled = false;
+    static bool bootstrapped = false;
+    static bool restored_initial_held_applied = false;
+    static uint32_t hook_linear = 0;
+    static bool hook_cs_relative = false;
+    static uint32_t hook_cs_offset = 0;
+    static bool hook_alt_enabled = false;
+    static uint32_t hook_alt_offset = 0;
+    static bool primary_hook_seen = false;
+    static PhysPt state_linear = 0;
+    static bool state_ds_relative = false;
+    static uint32_t state_ds_offset = 0;
+    static unsigned int state_width = 0;
+    static bool state_unwrap = false;
+    static bool have_last_raw_state = false;
+    static uint32_t last_raw_state = 0;
+    static uint64_t state_epoch_base = 0;
+    static bool configured_state_epoch_base = false;
+    static bool preapplied_enabled = false;
+    static uint64_t preapplied_through = 0;
+    static bool stop_enabled = false;
+    static uint64_t stop_value = 0;
+    static bool stop_armed = false;
+    static bool state_input_write_enabled = false;
+    static bool state_input_write_ds_relative = false;
+    static PhysPt state_input_write_linear = 0;
+    static uint32_t state_input_write_offset = 0;
+    static unsigned int state_input_write_width = 0;
+    static uint32_t state_input_write_value = 0;
+    static std::vector<StateInputEvent> events;
+    static std::map<KBD_KEYS, std::string> initial_held;
+    static std::vector<std::pair<KBD_KEYS, std::string>> initial_held_order;
+    static size_t next_event = 0;
+    static FILE *event_log = nullptr;
+    static FILE *trace_log = nullptr;
+
+    const auto fail = [](const std::string& message) {
+        E_Exit("DOS_RE_HARNESS state input: %s", message.c_str());
+    };
+    const auto parse_number = [&fail](const char *text,
+                                      const char *name) -> unsigned long {
+        if (!text || !*text) fail(std::string("missing ") + name);
+        char *end = nullptr;
+        const unsigned long value = strtoul(text, &end, 0);
+        if (end == text || *end != '\0') {
+            fail(std::string("invalid ") + name + ": " + text);
+        }
+        return value;
+    };
+    const auto trim = [](const std::string& value) -> std::string {
+        const size_t first = value.find_first_not_of(" \t\r\n");
+        if (first == std::string::npos) return "";
+        const size_t last = value.find_last_not_of(" \t\r\n");
+        return value.substr(first, last - first + 1);
+    };
+    const auto parse_event_value = [&fail](const std::string& text) -> uint64_t {
+        if (text.empty() || text[0] == '-') fail("invalid event state value");
+        char *end = nullptr;
+        const unsigned long long value = strtoull(text.c_str(), &end, 0);
+        if (end == text.c_str() || *end != '\0') {
+            fail("invalid event state value: " + text);
+        }
+        return static_cast<uint64_t>(value);
+    };
+
+    if (!initialized) {
+        initialized = true;
+        const char *script_path = getenv("DOS_RE_HARNESS_STATE_INPUT_SCRIPT");
+        const bool have_script = script_path && *script_path;
+        const char *stop_text = getenv(
+            "DOS_RE_HARNESS_STATE_INPUT_STOP_VALUE");
+        const bool have_stop = stop_text && *stop_text;
+        if (!have_script && !have_stop) return false;
+
+        const char *hook_offset_text =
+            getenv("DOS_RE_HARNESS_STATE_INPUT_HOOK_OFFSET");
+        const char *state_ds_offset_text =
+            getenv("DOS_RE_HARNESS_STATE_INPUT_DS_OFFSET");
+        const bool have_hook_offset = hook_offset_text && *hook_offset_text;
+        const bool have_state_ds_offset =
+            state_ds_offset_text && *state_ds_offset_text;
+        if (have_hook_offset != have_state_ds_offset) {
+            fail("CS-relative hook and DS-relative state must be configured together");
+        }
+        const unsigned long parsed_hook = have_hook_offset
+            ? parse_number(hook_offset_text, "hook instruction offset")
+            : parse_number(getenv("DOS_RE_HARNESS_STATE_INPUT_HOOK_LINEAR"),
+                           "hook linear address");
+        const unsigned long parsed_linear = have_state_ds_offset
+            ? parse_number(state_ds_offset_text, "state DS offset")
+            : parse_number(getenv("DOS_RE_HARNESS_STATE_INPUT_LINEAR"),
+                           "state linear address");
+        const unsigned long parsed_width = parse_number(
+            getenv("DOS_RE_HARNESS_STATE_INPUT_WIDTH"),
+            "state width");
+        if (parsed_hook > 0xfffffffful || parsed_linear > 0xfffffffful ||
+            (parsed_width != 1ul && parsed_width != 2ul && parsed_width != 4ul)) {
+            fail("hook, state address, or width is out of range");
+        }
+        hook_linear = static_cast<uint32_t>(parsed_hook);
+        hook_cs_relative = have_hook_offset;
+        hook_cs_offset = static_cast<uint32_t>(parsed_hook);
+        const char *hook_alt_text =
+            getenv("DOS_RE_HARNESS_STATE_INPUT_HOOK_OFFSET_ALT");
+        if (hook_alt_text && *hook_alt_text) {
+            const unsigned long parsed_alt = parse_number(
+                hook_alt_text, "alternate hook instruction offset");
+            if (parsed_alt > 0xfffful) {
+                fail("alternate hook instruction offset is out of range");
+            }
+            hook_alt_enabled = true;
+            hook_alt_offset = static_cast<uint32_t>(parsed_alt);
+        }
+        state_linear = static_cast<PhysPt>(parsed_linear);
+        state_ds_relative = have_state_ds_offset;
+        state_ds_offset = static_cast<uint32_t>(parsed_linear);
+        state_width = static_cast<unsigned int>(parsed_width);
+        if (have_stop) {
+            stop_value = parse_event_value(stop_text);
+            stop_enabled = true;
+        }
+        const char *write_offset_text = getenv(
+            "DOS_RE_HARNESS_STATE_INPUT_WRITE_OFFSET");
+        const char *write_linear_text = getenv(
+            "DOS_RE_HARNESS_STATE_INPUT_WRITE_LINEAR");
+        const bool have_write_offset = write_offset_text && *write_offset_text;
+        const bool have_write_linear = write_linear_text && *write_linear_text;
+        if (have_write_offset && have_write_linear) {
+            fail("state-input write offset and linear address are mutually exclusive");
+        }
+        if (have_write_offset || have_write_linear) {
+            state_input_write_ds_relative = have_write_offset;
+            const unsigned long parsed_write_address = have_write_offset
+                ? parse_number(write_offset_text, "state-input write DS offset")
+                : parse_number(write_linear_text, "state-input write linear address");
+            const unsigned long parsed_write_width = parse_number(
+                getenv("DOS_RE_HARNESS_STATE_INPUT_WRITE_WIDTH"),
+                "state-input write width");
+            const unsigned long parsed_write_value = parse_number(
+                getenv("DOS_RE_HARNESS_STATE_INPUT_WRITE_VALUE"),
+                "state-input write value");
+            if (parsed_write_address > 0xfffffffful ||
+                (parsed_write_width != 1ul && parsed_write_width != 2ul &&
+                 parsed_write_width != 4ul) ||
+                parsed_write_value > 0xfffffffful) {
+                fail("state-input write address, width, or value is out of range");
+            }
+            if (state_input_write_ds_relative) {
+                state_input_write_offset = static_cast<uint32_t>(
+                    parsed_write_address);
+            } else {
+                state_input_write_linear = static_cast<PhysPt>(
+                    parsed_write_address);
+            }
+            state_input_write_width = static_cast<unsigned int>(
+                parsed_write_width);
+            state_input_write_value = static_cast<uint32_t>(parsed_write_value);
+            state_input_write_enabled = true;
+        }
+
+        if (have_script) {
+            std::ifstream script(script_path);
+            if (!script) fail(std::string("cannot open script: ") + script_path);
+            std::string line;
+            bool saw_header = false;
+            uint64_t previous_value = 0;
+            bool have_previous_value = false;
+            std::map<KBD_KEYS, bool> held;
+            unsigned int line_number = 0;
+            while (std::getline(script, line)) {
+                ++line_number;
+                line = trim(line);
+                if (line.empty()) continue;
+                if (!saw_header) {
+                    if (line != "dos-re-state-input-script-v1") {
+                        fail("script header is not dos-re-state-input-script-v1");
+                    }
+                    saw_header = true;
+                    continue;
+                }
+                if (line == "# state_unwrap=1") {
+                    state_unwrap = true;
+                    continue;
+                }
+                const std::string epoch_base_prefix = "# state_epoch_base=";
+                if (line.compare(0, epoch_base_prefix.size(),
+                                 epoch_base_prefix) == 0) {
+                    if (configured_state_epoch_base) {
+                        fail("state_epoch_base was configured more than once");
+                    }
+                    state_epoch_base = parse_event_value(
+                        line.substr(epoch_base_prefix.size()));
+                    configured_state_epoch_base = true;
+                    continue;
+                }
+                const std::string preapplied_prefix = "# preapplied_through=";
+                if (line.compare(0, preapplied_prefix.size(),
+                                 preapplied_prefix) == 0) {
+                    preapplied_through = parse_event_value(
+                        line.substr(preapplied_prefix.size()));
+                    preapplied_enabled = true;
+                    continue;
+                }
+                const std::string initial_held_prefix =
+                    "# initial_held_qcodes=";
+                if (line.compare(0, initial_held_prefix.size(),
+                                 initial_held_prefix) == 0) {
+                    size_t key_start = initial_held_prefix.size();
+                    if (key_start == line.size()) continue;
+                    while (key_start <= line.size()) {
+                        const size_t plus = line.find('+', key_start);
+                        const std::string qcode = line.substr(
+                            key_start,
+                            plus == std::string::npos ? std::string::npos
+                                                      : plus - key_start);
+                        const KBD_KEYS key = qcode_to_kbd(qcode);
+                        if (qcode.empty() || key == KBD_NONE || held[key]) {
+                            fail("invalid initial held qcode at line " +
+                                 std::to_string(line_number) + ": " + qcode);
+                        }
+                        held[key] = true;
+                        initial_held[key] = qcode;
+                        initial_held_order.push_back({key, qcode});
+                        if (plus == std::string::npos) break;
+                        key_start = plus + 1;
+                    }
+                    continue;
+                }
+                if (line[0] == '#') continue;
+
+                const size_t equals = line.find('=');
+                const size_t dot = line.find('.', equals == std::string::npos
+                                                    ? 0 : equals + 1);
+                if (equals == std::string::npos || dot == std::string::npos ||
+                    equals == 0 || dot == equals + 1 || dot + 1 >= line.size()) {
+                    fail("invalid event at line " + std::to_string(line_number));
+                }
+                const std::string value_text = line.substr(0, equals);
+                StateInputEvent event;
+                event.value = parse_event_value(value_text);
+                const std::string transition = line.substr(
+                    equals + 1, dot - equals - 1);
+                if (transition == "down") event.pressed = true;
+                else if (transition == "up") event.pressed = false;
+                else fail("invalid transition at line " +
+                          std::to_string(line_number));
+                if (have_previous_value && event.value < previous_value) {
+                    fail("event state values are not ordered");
+                }
+                previous_value = event.value;
+                have_previous_value = true;
+
+                size_t key_start = dot + 1;
+                std::map<KBD_KEYS, bool> event_keys;
+                while (key_start <= line.size()) {
+                    const size_t plus = line.find('+', key_start);
+                    const std::string qcode = line.substr(
+                        key_start,
+                        plus == std::string::npos ? std::string::npos
+                                                  : plus - key_start);
+                    const KBD_KEYS key = qcode_to_kbd(qcode);
+                    if (qcode.empty() || key == KBD_NONE) {
+                        fail("unknown qcode at line " +
+                             std::to_string(line_number) + ": " + qcode);
+                    }
+                    if (event_keys[key]) {
+                        fail("duplicate qcode at line " +
+                             std::to_string(line_number) + ": " + qcode);
+                    }
+                    event_keys[key] = true;
+                    if (event.pressed && held[key]) {
+                        fail("qcode pressed while held at line " +
+                             std::to_string(line_number) + ": " + qcode);
+                    }
+                    if (!event.pressed && !held[key]) {
+                        fail("qcode released while not held at line " +
+                             std::to_string(line_number) + ": " + qcode);
+                    }
+                    held[key] = event.pressed;
+                    event.keys.push_back(key);
+                    event.qcodes.push_back(qcode);
+                    if (plus == std::string::npos) break;
+                    key_start = plus + 1;
+                }
+                events.push_back(event);
+            }
+            if (!saw_header || events.empty()) fail("script has no events");
+            for (const auto& item : held) {
+                if (item.second) fail("script ends with held qcodes");
+            }
+            if (preapplied_enabled) {
+                while (next_event < events.size() &&
+                       events[next_event].value <= preapplied_through) {
+                    ++next_event;
+                }
+            }
+        }
+
+        const char *log_path = getenv("DOS_RE_HARNESS_STATE_INPUT_LOG");
+        if (log_path && *log_path) {
+            event_log = fopen(log_path, "wb");
+            if (!event_log) fail(std::string("cannot open log: ") + log_path);
+            fputs("tick_ms,state,phase,transition,qcode\n", event_log);
+            fflush(event_log);
+        }
+        const char *trace_path = getenv("DOS_RE_HARNESS_STATE_INPUT_TRACE");
+        if (trace_path && *trace_path) {
+            trace_log = fopen(trace_path, "wb");
+            if (!trace_log) fail(std::string("cannot open trace: ") + trace_path);
+            fputs("tick_ms,state,raw_state,linear_pc,instruction_offset,ds_base,state_address\n",
+                  trace_log);
+            fflush(trace_log);
+        }
+        enabled = true;
+        if (have_script) {
+            LOG(LOG_REMOTE, LOG_NORMAL)(
+                "State input: loaded %u events at %s 0x%08X from %s",
+                static_cast<unsigned int>(events.size()),
+                hook_cs_relative ? "CS-offset" : "linear",
+                hook_linear, script_path);
+        } else {
+            LOG(LOG_REMOTE, LOG_NORMAL)(
+                "Guest state stop: armed value %llu at %s 0x%08X",
+                static_cast<unsigned long long>(stop_value),
+                hook_cs_relative ? "CS-offset" : "linear", hook_linear);
+        }
+    }
+
+    if (!enabled) return false;
+    if (!bootstrapped && !restored_initial_held_applied &&
+        SAVESTATE_ConsumeLoadPauseRelease()) {
+        for (const auto& item : initial_held_order) {
+            KEYBOARD_AddKey(item.first, true);
+            if (event_log) {
+                fprintf(event_log, "%.6f,0,restore-bootstrap,down,%s\n",
+                        static_cast<double>(PIC_Ticks), item.second.c_str());
+            }
+        }
+        restored_initial_held_applied = !initial_held_order.empty();
+        if (event_log) fflush(event_log);
+    }
+    const PhysPt active_state_linear = state_ds_relative
+        ? static_cast<PhysPt>(ds_base + state_ds_offset) : state_linear;
+    if (hook_cs_relative) {
+        const bool primary_match = instruction_offset == hook_cs_offset ||
+                                   linear_pc == hook_cs_offset;
+        const bool alternate_match = hook_alt_enabled && primary_hook_seen &&
+                                     (instruction_offset == hook_alt_offset ||
+                                      linear_pc == hook_alt_offset);
+        if (!primary_match && !alternate_match) return false;
+        if (primary_match) primary_hook_seen = true;
+    } else if (linear_pc != hook_linear) {
+        return false;
+    }
+    if (state_input_write_enabled) {
+        const PhysPt write_address = state_input_write_ds_relative
+            ? static_cast<PhysPt>(ds_base + state_input_write_offset)
+            : state_input_write_linear;
+        if (state_input_write_width == 1) {
+            mem_writeb(write_address,
+                       static_cast<uint8_t>(state_input_write_value));
+        } else if (state_input_write_width == 2) {
+            mem_writew(write_address,
+                       static_cast<uint16_t>(state_input_write_value));
+        } else {
+            mem_writed(write_address, state_input_write_value);
+        }
+    }
+    uint32_t raw_state = 0;
+    if (state_width == 1) raw_state = mem_readb(active_state_linear);
+    else if (state_width == 2) raw_state = mem_readw(active_state_linear);
+    else raw_state = mem_readd(active_state_linear);
+    if (state_unwrap && have_last_raw_state && raw_state < last_raw_state) {
+        const uint64_t modulus = uint64_t{1} << (state_width * 8u);
+        if (state_epoch_base + modulus < state_epoch_base) {
+            fail("unwrapped guest state overflowed");
+        }
+        state_epoch_base += modulus;
+    }
+    last_raw_state = raw_state;
+    have_last_raw_state = true;
+    const uint64_t state = state_epoch_base + raw_state;
+    dos_re_harness_guest_state = state;
+    if (trace_log) {
+        fprintf(trace_log, "%.6f,%llu,%u,0x%08X,0x%08X,0x%08X,0x%08X\n",
+                static_cast<double>(PIC_Ticks),
+                static_cast<unsigned long long>(state),
+                static_cast<unsigned int>(raw_state),
+                static_cast<unsigned int>(linear_pc),
+                static_cast<unsigned int>(instruction_offset),
+                static_cast<unsigned int>(ds_base),
+                static_cast<unsigned int>(active_state_linear));
+        fflush(trace_log);
+    }
+
+    bool queued_input = false;
+    const auto apply_event = [state, &queued_input, &fail](
+                                 const StateInputEvent& event,
+                                 const char *phase) {
+        if (!qmpServer) fail("QMP server is unavailable");
+        for (size_t index = 0; index < event.keys.size(); ++index) {
+            QMPInputEvent queued;
+            queued.type = event.pressed ? QMPInputEventType::KeyPress
+                                        : QMPInputEventType::KeyRelease;
+            queued.key = event.keys[index];
+            qmpServer->queue_input_event(queued);
+            queued_input = true;
+            if (event_log) {
+                fprintf(event_log, "%.6f,%llu,%s,%s,%s\n",
+                        static_cast<double>(PIC_Ticks),
+                        static_cast<unsigned long long>(state), phase,
+                        event.pressed ? "down" : "up",
+                        event.qcodes[index].c_str());
+            }
+        }
+        if (event_log) fflush(event_log);
+    };
+
+    if (!bootstrapped) {
+        std::map<KBD_KEYS, std::string> held = initial_held;
+        while (next_event < events.size() &&
+               events[next_event].value < state) {
+            const StateInputEvent& event = events[next_event++];
+            for (size_t index = 0; index < event.keys.size(); ++index) {
+                if (event.pressed) held[event.keys[index]] = event.qcodes[index];
+                else held.erase(event.keys[index]);
+            }
+        }
+        if (!held.empty() && !qmpServer) fail("QMP server is unavailable");
+        std::map<KBD_KEYS, bool> applied;
+        std::vector<KBD_KEYS> bootstrap_order;
+        for (const auto& item : initial_held_order) {
+            if (held.count(item.first) && !applied[item.first]) {
+                bootstrap_order.push_back(item.first);
+                applied[item.first] = true;
+            }
+        }
+        for (const auto& item : held) {
+            if (!applied[item.first]) {
+                bootstrap_order.push_back(item.first);
+                applied[item.first] = true;
+            }
+        }
+        for (const KBD_KEYS key : bootstrap_order) {
+            const auto item = held.find(key);
+            if (item == held.end()) continue;
+            if (restored_initial_held_applied && initial_held.count(item->first)) {
+                continue;
+            }
+            KEYBOARD_AddKey(item->first, true);
+            queued_input = true;
+            if (event_log) {
+                fprintf(event_log, "%.6f,%llu,bootstrap,down,%s\n",
+                        static_cast<double>(PIC_Ticks),
+                        static_cast<unsigned long long>(state),
+                        initial_held.count(item->first)
+                            ? initial_held[item->first].c_str()
+                            : "");
+            }
+        }
+        if (event_log) fflush(event_log);
+        bootstrapped = true;
+    }
+
+    if (next_event < events.size() && events[next_event].value < state) {
+        fail("guest state skipped scheduled value " +
+             std::to_string(events[next_event].value));
+    }
+    while (next_event < events.size() &&
+           events[next_event].value == state) {
+        apply_event(events[next_event], "event");
+        ++next_event;
+    }
+    if (stop_enabled && !stop_armed && state == stop_value) {
+        if (!DEBUG_RequestGDBStop()) {
+            fail("cannot stop GDB client at guest state");
+        }
+        stop_armed = true;
+        queued_input = true;
+        LOG(LOG_REMOTE, LOG_NORMAL)(
+            "State input: stopped at state %llu on linear 0x%08X",
+            static_cast<unsigned long long>(state),
+            linear_pc);
     }
+    return queued_input;
+}
