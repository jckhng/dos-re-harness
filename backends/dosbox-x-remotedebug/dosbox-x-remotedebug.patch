+
+    std::ostringstream response;
+    response << "{\"return\":{\"data\":\""
+             << base64_encode(frame.pixels)
+             << "\",\"size\": " << frame.pixels.size()
+             << ",\"palette\":\"" << base64_encode(frame.palette)
+             << "\",\"palette_size\":" << frame.palette.size()
+             << ",\"width\": " << static_cast<unsigned long>(frame.width)
+             << ",\"height\": " << static_cast<unsigned long>(frame.height)
+             << ",\"bpp\": " << static_cast<unsigned long>(frame.bpp)
+             << ",\"pitch\": " << static_cast<unsigned long>(frame.pitch)
+             << ",\"generation\": "
+             << static_cast<unsigned long long>(frame.generation)
+             << "}}\r\n";
