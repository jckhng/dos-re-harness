+    response << "{\"return\":{\"data\":\""
+             << base64_encode(data)
+             << "\",\"size\": " << data.size()
+             << ",\"bits\": " << static_cast<unsigned int>(vga.dac.bits)
+             << ",\"pel_mask\": " << static_cast<unsigned int>(vga.dac.pel_mask)
+             << ",\"pel_index\": " << static_cast<unsigned int>(vga.dac.pel_index)
+             << ",\"state\": " << static_cast<unsigned int>(vga.dac.state)
+             << ",\"write_index\": " << static_cast<unsigned int>(vga.dac.write_index)
+             << ",\"read_index\": " << static_cast<unsigned int>(vga.dac.read_index)
+             << ",\"first_changed\": " << static_cast<unsigned long>(vga.dac.first_changed)
+             << "}}\r\n";
+    send_response(response.str());
+}
