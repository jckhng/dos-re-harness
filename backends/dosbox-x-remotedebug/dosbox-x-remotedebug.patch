+    data.reserve(256u * 3u);
+    for (unsigned int index = 0; index < 256u; ++index) {
+        data.push_back(vga.dac.rgb[index].red);
+        data.push_back(vga.dac.rgb[index].green);
+        data.push_back(vga.dac.rgb[index].blue);
