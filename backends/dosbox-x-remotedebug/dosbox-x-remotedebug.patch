+        initialized = true;
+        const char *path = getenv("DOS_RE_HARNESS_OPL_LOG");
+        const char *loop_tick = getenv("DOS_RE_HARNESS_OPL_TICK_LINEAR");
+        const char *loop_tick_ds = getenv("DOS_RE_HARNESS_OPL_TICK_DS_OFFSET");
+        if (loop_tick_ds && *loop_tick_ds) {
+            char *end = nullptr;
+            const unsigned long parsed = strtoul(loop_tick_ds, &end, 0);
+            if (end != loop_tick_ds && *end == '\0') {
+                include_loop_tick = true;
+                loop_tick_ds_relative = true;
+                loop_tick_ds_offset = static_cast<uint32_t>(parsed);
+            }
+        }
+        if (!loop_tick_ds_relative && loop_tick && *loop_tick) {
+            char *end = nullptr;
+            const unsigned long parsed = strtoul(loop_tick, &end, 0);
+            if (end != loop_tick && *end == '\0') {
+                include_loop_tick = true;
+                loop_tick_address = static_cast<PhysPt>(parsed);
+            }
+        }
+        if (path && *path) {
+            log = fopen(path, "wb");
+            if (log) {
+                if (include_loop_tick) {
+                    fputs("tick_ms,loop_tick,reg_hex,value_hex\n", log);
+                } else {
+                    fputs("tick_ms,reg_hex,value_hex\n", log);
+                }
+                fflush(log);
+            }
+        }
+    }
+
+    if (log) {
+        if (include_loop_tick) {
+            const PhysPt address = loop_tick_ds_relative
+                ? static_cast<PhysPt>(SegPhys(ds) + loop_tick_ds_offset)
+                : loop_tick_address;
+            uint64_t sampled_loop_tick = mem_readw(address);
+#if C_REMOTEDEBUG
+            const uint64_t state_input_tick = QMP_GetGuestStateInputValue();
+            if (state_input_tick != 0) sampled_loop_tick = state_input_tick;
+#endif
+            fprintf(log, "%.6f,%u,0x%03x,0x%02x\n", static_cast<double>(PIC_Ticks), static_cast<unsigned>(sampled_loop_tick), static_cast<unsigned>(reg), static_cast<unsigned>(val));
+        } else {
+            fprintf(log, "%.6f,0x%03x,0x%02x\n", static_cast<double>(PIC_Ticks), static_cast<unsigned>(reg), static_cast<unsigned>(val));
+        }
+        fflush(log);
+    }
