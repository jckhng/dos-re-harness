+void QMPServer::handle_displayhistory_start(const std::string& cmd) {
+    const int capacity = extract_int(cmd, "capacity", 0);
+    if (capacity < 1 || capacity > 64) {
+        send_error("GenericError", "display history capacity must be in 1..64");
+        return;
+    }
+    const uint64_t generation = RENDER_StartCompletedSourceFrameHistory(
+        static_cast<size_t>(capacity));
+    std::ostringstream response;
+    response << "{\"return\":{\"capacity\":" << capacity
+             << ",\"generation\":"
+             << static_cast<unsigned long long>(generation)
+             << "}}\r\n";
+    send_response(response.str());
+}
+
+void QMPServer::handle_displayhistory_stop() {
+    std::vector<RenderSourceFrame> frames;
+    size_t capacity = 0;
+    uint64_t dropped = 0;
+    if (!RENDER_TakeCompletedSourceFrameHistory(frames, capacity, dropped)) {
+        send_error("GenericError", "Completed display history is not active");
+        return;
+    }
+
+    std::ostringstream response;
+    response << "{\"return\":{\"capacity\":"
+             << static_cast<unsigned long>(capacity)
+             << ",\"dropped\":"
+             << static_cast<unsigned long long>(dropped)
+             << ",\"frames\":[";
+    for (size_t index = 0; index < frames.size(); ++index) {
+        const RenderSourceFrame &frame = frames[index];
+        std::vector<uint8_t> compressed(compressBound(frame.pixels.size()));
+        uLongf compressed_size = compressed.size();
+        const int compression_status = compress2(
+            compressed.data(),
+            &compressed_size,
+            frame.pixels.data(),
+            frame.pixels.size(),
+            Z_BEST_SPEED);
+        const bool use_compressed = compression_status == Z_OK &&
+                                    compressed_size < frame.pixels.size();
+        compressed.resize(use_compressed ? compressed_size : 0);
+        const std::vector<uint8_t> &payload = use_compressed
+            ? compressed
+            : frame.pixels;
+        if (index != 0)
+            response << ',';
+        response << "{\"data\":\"" << base64_encode(payload)
+                 << "\",\"encoding\":\""
+                 << (use_compressed ? "zlib" : "raw")
+                 << "\",\"size\":" << frame.pixels.size()
+                 << ",\"palette\":\"" << base64_encode(frame.palette)
+                 << "\",\"palette_size\":" << frame.palette.size()
+                 << ",\"width\":" << static_cast<unsigned long>(frame.width)
+                 << ",\"height\":" << static_cast<unsigned long>(frame.height)
+                 << ",\"bpp\":" << static_cast<unsigned long>(frame.bpp)
+                 << ",\"pitch\":" << static_cast<unsigned long>(frame.pitch)
+                 << ",\"generation\":"
+                 << static_cast<unsigned long long>(frame.generation)
+                 << '}';
+    }
+    response << "]}}\r\n";
+    send_response(response.str());
+}
